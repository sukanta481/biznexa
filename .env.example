DB_TARGET=local

DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_PORT=3306
DB_LOCAL_NAME=d2w_cms
DB_LOCAL_USER=root
DB_LOCAL_PASSWORD=

DB_LIVE_HOST=your-aurora-endpoint.cluster-xxxxxxxxxx.ap-south-1.rds.amazonaws.com
DB_LIVE_PORT=3306
DB_LIVE_NAME=biznexa
DB_LIVE_USER=admin
DB_LIVE_PASSWORD=your-live-password

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=info@biznexa.tech

# WhatsApp inbox (Cloud API v22.0). See docs/superpowers/plans/2026-08-05-whatsapp-inbox.md
WHATSAPP_TOKEN=your-permanent-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_INGEST_SECRET=generate-with-openssl-rand-hex-32

# Optional: durable media storage (S3). When unset, media + admin uploads fall
# back to public/uploads on the local disk (which does NOT work in Amplify SSR).
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE=

# Encryption key for the integration_credentials table (AES-256-GCM).
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This is set ONCE and never rotated; rotating invalidates every stored credential.
CREDENTIALS_KEY=your-64-hex-char-key
